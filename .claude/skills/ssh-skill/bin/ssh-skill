#!/usr/bin/env bash
# Platform-agnostic launcher: pick the correct prebuilt binary for the current OS.
# Keeps `${CLAUDE_SKILL_DIR}/bin/ssh-skill` stable across Windows, Linux and macOS;
# the real binaries live under <os>-<arch> suffixed names next to this script.
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*|Windows_NT)
    BIN="ssh-skill-windows-amd64.exe"
    IS_MSYS=1
    ;;
  Linux*)  BIN="ssh-skill-linux-amd64" ;;
  Darwin*) BIN="ssh-skill-darwin-amd64" ;;
  *) echo "[ssh-skill] unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

BIN_PATH="$DIR/$BIN"
if [ ! -f "$BIN_PATH" ]; then
  echo "[ssh-skill] missing platform binary: $BIN_PATH" >&2
  echo "[ssh-skill] rebuild with scripts/build.sh or scripts/build.ps1" >&2
  exit 127
fi

if [ "${IS_MSYS:-}" = "1" ]; then
  args=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --remote|--command)
        if [ "$#" -gt 1 ]; then
          args+=("$1=$2")
          shift 2
          continue
        fi
        ;;
    esac
    args+=("$1")
    shift
  done

  # MSYS converts Unix-looking arguments before launching a native .exe. Preserve
  # remote paths and remote shell commands, but retain conversion for --local paths.
  MSYS2_ARG_CONV_EXCL="${MSYS2_ARG_CONV_EXCL:+${MSYS2_ARG_CONV_EXCL};}--remote=;--command="
  export MSYS2_ARG_CONV_EXCL
  exec "$BIN_PATH" "${args[@]}"
fi

exec "$BIN_PATH" "$@"